# ============================================================
# Elemu Lestari · .env.example
# ------------------------------------------------------------
# This file is committed as a template. DO NOT put real keys here.
# Copy this to `.env` (which is .gitignored) for local development
# with `netlify dev`. For production, set these variables in the
# Netlify dashboard:
#   Site → Site configuration → Environment variables
# ============================================================

# Google AI Studio key for the Gemini-backed /api/ask fallback.
# Get a free key at: https://aistudio.google.com/apikey
# The key is read server-side by netlify/functions/ask.js and is
# NEVER exposed to the browser.
GEMINI_API_KEY=your-google-ai-studio-key-here
